# Example environment variables. Never put real secrets here.
# Values in this file document the production variables supplied by Rancher Secret.
Geoapify__ApiKey=
Geoapify__BaseUrl=https://api.geoapify.com
Geoapify__RoutingMode=drive
Geoapify__RequestsPerSecond=2
Geoapify__RetryMaxAttempts=2

# Local example URI has no credentials; production uses Rancher Secret.
Mongo__ConnectionString=mongodb://localhost:27017
Mongo__Database=rpaotelrezervasyon
Mongo__GeocodeCollection=geocode_cache
Mongo__CacheTtlDays=180

Api__ApiKey=
Reporting__MapWidthPx=640
Reporting__MapHeightPx=360
Reporting__MaxDocumentBytes=5242880
Reporting__DocumentTitle=Otel Onerisi

StaticMap__BaseUrl=https://maps.geoapify.com/v1/staticmap
StaticMap__Style=osm-bright
StaticMap__Attribution=Powered by Geoapify
StaticMap__RequestsPerSecond=1
StaticMap__RetryMaxAttempts=2
StaticMap__MaxZoom=18
