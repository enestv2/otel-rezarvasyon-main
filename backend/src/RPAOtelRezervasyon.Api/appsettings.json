{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Geoapify": {
    "BaseUrl": "https://api.geoapify.com",
    "ApiKey": "",
    "RequestsPerSecond": 2,
    "RetryMaxAttempts": 2,
    "RoutingMode": "drive"
  },
  "Reporting": {
    "MapWidthPx": 640,
    "MapHeightPx": 360,
    "MaxDocumentBytes": 5242880,
    "DocumentTitle": "Otel Önerisi"
  },
  "TaxiFare": {
    "DefaultOpeningFare": 71.94,
    "DefaultFarePerKm": 47.92,
    "DefaultCurrency": "TRY",
    "DefaultRates": {
      "EUR": {
        "OpeningFare": 1.29,
        "FarePerKm": 0.86
      },
      "USD": {
        "OpeningFare": 1.45,
        "FarePerKm": 0.97
      }
    },
    "MaxFareAgeDays": 180
  },
  "StaticMap": {
    "BaseUrl": "https://maps.geoapify.com/v1/staticmap",
    "Style": "osm-bright",
    "Attribution": "Powered by Geoapify",
    "RequestsPerSecond": 1,
    "RetryMaxAttempts": 2,
    "MaxZoom": 18
  },
  "Mongo": {
    "Database": "rpaotelrezervasyon",
    "GeocodeCollection": "geocode_cache",
    "CacheTtlDays": 180
  }
}
